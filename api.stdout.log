      Executed DbCommand (22ms) [Parameters=[@from_Value='?' (DbType = DateTime), @to_Value='?' (DbType = DateTime), @branchId_Value='?' (DbType = Guid), @p='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']
      SELECT s1."Id", s1."AppointmentId", s1."BranchId", s1."CreatedAt", s1."CustomerId", s1."Discount", s1."PaymentMethod", s1."RoomId", s1."SaleNumber", s1."StaffId", s1."Status", s1."Subtotal", s1."Total", s0."Id", s0."LineTotal", s0."Quantity", s0."SaleId", s0."ServiceId", s0."ServiceName", s0."UnitPrice"
      FROM (
          SELECT s."Id", s."AppointmentId", s."BranchId", s."CreatedAt", s."CustomerId", s."Discount", s."PaymentMethod", s."RoomId", s."SaleNumber", s."StaffId", s."Status", s."Subtotal", s."Total"
